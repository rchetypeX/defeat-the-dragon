{
  "root": true,
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "extends": ["eslint:recommended", "next/core-web-vitals"],
  "rules": {
    "@next/next/no-html-link-for-pages": "off",
    "@next/next/no-img-element": "off",
    "react/no-unescaped-entities": "off"
  },
  "ignorePatterns": [
    ".next/",
    ".turbo/",
    "dist/",
    "node_modules/",
    "*.config.js",
    "next-env.d.ts"
  ],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module",
        "ecmaFeatures": {
          "jsx": true
        }
      },
      "rules": {
        "no-undef": "off",
        "no-unused-vars": "off",
        "no-redeclare": "off"
      }
    },
    {
      "files": ["*.test.ts", "*.test.tsx"],
      "env": {
        "node": true
      }
    }
  ]
}
